# Generic API config. Works with Anthropic-compatible endpoints such as DeepSeek.
APIKEY=sk-your-api-key
API=https://api.deepseek.com/anthropic
MODEL=claude-sonnet-4-6

# Anthropic native config.
# ANTHROPIC_API_KEY=sk-ant-your-api-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI-compatible config.
# OPENAI_API_KEY=sk-your-api-key
# OPENAI_BASE_URL=https://your-openai-compatible-host/v1
# MODEL=gpt-4o

# Estimated USD per million tokens. Set these for your actual provider/model.
# MAWOAGENT_INPUT_PRICE_PER_MILLION=3
# MAWOAGENT_OUTPUT_PRICE_PER_MILLION=15
# Maximum seconds to wait for background Skill work before cancellation on exit.
# MAWOAGENT_SHUTDOWN_TIMEOUT=5
# Optional model capacity override in tokens; unknown models otherwise use 32000.
# MAWOAGENT_CONTEXT_WINDOW=32000
# Bounded background learning. Interrupted jobs are persisted for retry.
# MAWOAGENT_SKILL_CONCURRENCY=2
# MAWOAGENT_SKILL_QUEUE_LIMIT=16
# Optional separate judge model on the same provider/API connection.
# MAWOAGENT_SKILL_JUDGE_MODEL=your-judge-model
